# Existing shared Supabase identity project; browser keys are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Central API cutover: keep false until api.binzeo is deployed and verified.
CENTRAL_API_ENABLED=false
CENTRAL_API_BASE_URL=https://api-binzeo.vercel.app
NEXT_PUBLIC_CENTRAL_API_ENABLED=false
NEXT_PUBLIC_ADMIN_APP_URL=https://admin-binzeo.vercel.app

# Frontend origin used for OAuth callback links and account emails
NEXT_PUBLIC_SITE_URL=https://auth-binzeo.vercel.app
